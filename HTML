app = Flask(__name__)
DB_NAME = "sovereign_empire.db"

# 1. असली डेटाबेस सेटअप (मास्टर वॉल्ट और टोकन के लिए)
def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS empire_state (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            vault_balance REAL,
            tokens REAL,
            status_msg TEXT
        )
    ''')
    cursor.execute('SELECT COUNT(*) FROM empire_state')
    if cursor.fetchone()[0] == 0:
        cursor.execute('INSERT INTO empire_state (vault_balance, tokens, status_msg) VALUES (?, ?, ?)', 
                       (25000.0, 1250.0, '🟢 Live & Operational'))
    conn.commit()
    conn.close()

init_db()

def get_empire_state():
    conn = sqlite3.connect(DB_NAME)
    conn.row_factory = sqlite3.Row
    cursor = conn.cursor()
    state = cursor.execute('SELECT * FROM empire_state WHERE id = 1').fetchone()
    conn.close()
    return state

def update_empire_state(vault, tokens, status):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('UPDATE empire_state SET vault_balance = ?, tokens = ?, status_msg = ? WHERE id = 1', 
                   (vault, tokens, status))
    conn.commit()
    conn.close()

