@app.route("/")
def index():
    state = get_empire_state()
    msg = request.args.get("msg", "")
    return render_template_string(HTML_DASHBOARD, state=state, msg=msg)

@app.route("/withdraw", methods=["POST"])
def withdraw():
    state = get_empire_state()
    vault = state["vault_balance"]
    tokens = state["tokens"]
    
    if vault >= 5000:
        vault -= 5000
        tokens += 50.0
        msg = "✅ सफलता: ₹5,000 मास्टर विथड्रॉल प्रोसेस हुआ और डेटाबेस अपडेट हो गया।"
    else:
        msg = "❌ एरर: मास्टर वॉल्ट में पर्याप्त राशि नहीं है!"
        
    update_empire_state(vault, tokens, msg)
    return redirect(url_for("index", msg=msg))

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 5000)), debug=True)
